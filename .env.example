# ========================================================
# CRONUS — VARIÁVEIS DE AMBIENTE (PRODUÇÃO / NETLIFY / TURSO)
# ========================================================
#
# Para conectar ao seu banco Turso na nuvem:
# 1. Copie este arquivo para .env (ou configure no Netlify em: Site configuration > Environment variables)
# 2. Preencha com os dados do seu banco criado no Turso:

TURSO_DATABASE_URL=libsql://seu-banco-seu-usuario.turso.io
TURSO_AUTH_TOKEN=seu_token_aqui
